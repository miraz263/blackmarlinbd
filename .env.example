
# ════════════════════════════════════════════════════════════════
#  BlackMarlinBD — Environment Template
#  Copy to .env and fill in real values. NEVER commit .env.
# ════════════════════════════════════════════════════════════════

# ─── Django Core ──────────────────────────────────────────────
# Generate: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(50)))"
SECRET_KEY=CHANGE_ME

# development | production
DEBUG=False
ALLOWED_HOSTS=blackmarlinbd.com,www.blackmarlinbd.com

# config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.production

# ─── Database ─────────────────────────────────────────────────
DB_NAME=blackmarlinbd
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# ─── JWT Cookies ──────────────────────────────────────────────
AUTH_COOKIE_SECURE=True

# ─── Email ────────────────────────────────────────────────────
# Development: overridden to console by config.settings.development
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=noreply@blackmarlinbd.com

# ─── CORS / CSRF ──────────────────────────────────────────────
# Development: use http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://blackmarlinbd.com,https://www.blackmarlinbd.com
CSRF_TRUSTED_ORIGINS=https://blackmarlinbd.com,https://www.blackmarlinbd.com

# ─── Security ─────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ─── Storage ──────────────────────────────────────────────────
# Options: local | s3 | r2
STORAGE_BACKEND=local
USE_S3=False

# AWS S3 (activate with STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Cloudflare R2 (activate with STORAGE_BACKEND=r2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_CUSTOM_DOMAIN=

# ─── AI Providers ─────────────────────────────────────────────
# Default provider: openai | gemini
AI_DEFAULT_PROVIDER=openai
AI_MAX_TOKENS=2048

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-1.5-flash

# ─── Sentry ───────────────────────────────────────────────────
SENTRY_DSN=

# ─── Frontend ─────────────────────────────────────────────────
VITE_API_URL=/api/v1
VITE_WS_HOST=
