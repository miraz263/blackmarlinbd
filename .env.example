# ─── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=blackmarlinbd.com,www.blackmarlinbd.com
DJANGO_SETTINGS_MODULE=config.settings.production

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=blackmarlinbd
DB_USER=postgres
DB_PASSWORD=change_this_strong_password
DB_HOST=db
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:change_this_redis_password@redis:6379/0
REDIS_PASSWORD=change_this_redis_password

# ─── JWT Cookies ──────────────────────────────────────────────────────────────
AUTH_COOKIE_SECURE=True

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=noreply@blackmarlinbd.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://blackmarlinbd.com,https://www.blackmarlinbd.com
CSRF_TRUSTED_ORIGINS=https://blackmarlinbd.com,https://www.blackmarlinbd.com

# ─── AWS S3 (optional) ────────────────────────────────────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=/api/v1
VITE_WS_HOST=
